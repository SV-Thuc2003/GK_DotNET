<Window x:Class="WpfStudentApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:WpfStudentApp.ViewModels"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Student Manager" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F0F0F0">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <materialDesign:Card Background="White" Margin="20" UniformCornerRadius="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <TextBlock Text="Student Manager"
                       Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                       FontWeight="Bold" Foreground="#444"
                       Margin="0 0 0 20"/>

            <!-- INPUT FORM -->
            <Grid Grid.Row="1" Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Tên sinh viên" 
                           VerticalAlignment="Center" Margin="0 0 20 0" FontWeight="SemiBold"/>

                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding InputName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Height="40" Padding="10 8" Margin="0 0 10 15"/>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="10 0 0 15">
                    <Button Content="Thêm" Command="{Binding AddCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Background="#0091EA" BorderBrush="#0091EA"
                            Width="80" Margin="5 0"/>

                    <Button Content="Cập nhật" Command="{Binding UpdateCommand}"
                            Style="{StaticResource MaterialDesignPaperButton}"
                            Width="90" Margin="5 0"/>

                    <Button Content="Xoá" Command="{Binding DeleteCommand}"
                            Style="{StaticResource MaterialDesignPaperButton}"
                            Width="70" Margin="5 0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Tuổi" 
                           VerticalAlignment="Center" Margin="0 0 20 0" FontWeight="SemiBold"/>

                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding InputAge, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Height="40" Padding="10 8" Margin="0 0 10 15"/>
            </Grid>

            <!-- SEARCH + SORT -->
            <Grid Grid.Row="2" Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Tìm kiếm theo tên..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Padding="10"/>

                <Button Grid.Column="1" Content="Sắp xếp theo tuổi"
                        Command="{Binding SortAgeCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Margin="10 0 0 0"/>
            </Grid>

            <!-- DATA TABLE -->
            <DataGrid Grid.Row="3"
                      ItemsSource="{Binding Students}"
                      SelectedItem="{Binding SelectedStudent}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="All"
                      materialDesign:DataGridAssist.CellPadding="10"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="10">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                    <DataGridTextColumn Header="Tên Sinh Viên" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Tuổi" Binding="{Binding Age}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- EXPORT BUTTONS -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
                <Button Content="Xuất CSV" Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="5"/>
                <Button Content="Xuất JSON" Command="{Binding ExportJsonCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="5"/>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</Window>
