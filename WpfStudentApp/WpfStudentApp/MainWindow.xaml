<Window x:Class="WpfStudentApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfStudentApp"
        xmlns:vm="clr-namespace:WpfStudentApp.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NHẬP THÔNG TIN -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="Tên sinh viên"/>
                <TextBox Width="200" Text="{Binding InputName, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="Tuổi"/>
                <TextBox Width="100" Text="{Binding InputAge, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <Button Content="Thêm"
                    Command="{Binding AddCommand}"
                    Width="80" Margin="10 0"/>
        </StackPanel>

        <!-- DANH SÁCH SINH VIÊN -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Students}"
                  SelectedItem="{Binding SelectedStudent}"
                  AutoGenerateColumns="True"
                  Margin="0 10 0 50"/>

        <!-- BUTTON CHỨC NĂNG -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Bottom">
            <Button Content="Cập nhật"
                    Command="{Binding UpdateCommand}"
                    Width="100" Margin="5"/>

            <Button Content="Xoá"
                    Command="{Binding DeleteCommand}"
                    Width="100" Margin="5"/>
        </StackPanel>

    </Grid>
</Window>
