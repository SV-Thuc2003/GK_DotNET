<UserControl x:Class="WPFStudent.Views.StudentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WPFStudent.ViewModels"
             xmlns:conv="clr-namespace:WPFStudent.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <x:Array x:Key="GendersList" Type="sys:String">
            <sys:String>Nam</sys:String>
            <sys:String>Nữ</sys:String>
            <sys:String>Khác</sys:String>
        </x:Array>

        <conv:Base64ToImageConverter x:Key="Base64ToImageConverter"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Form thông tin sinh viên -->
        <StackPanel>
            <TextBox materialDesign:HintAssist.Hint="Mã SV"
                     Text="{Binding StudentId, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     PreviewTextInput="StudentId_PreviewTextInput"
                     MaxLength="8"
                     Margin="0,6"/>
            <TextBox materialDesign:HintAssist.Hint="Tên"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,6"/>
            <TextBox materialDesign:HintAssist.Hint="Tuổi"
                     Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,6"/>

            <ComboBox ItemsSource="{StaticResource GendersList}"
                      SelectedItem="{Binding Gender}"
                      Margin="0,6"
                      materialDesign:HintAssist.Hint="Giới tính"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <StackPanel>
                    <TextBlock Text="Toán" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding MathGrade, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                </StackPanel>
                <StackPanel Margin="6,0,0,0">
                    <TextBlock Text="Lý" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding PhysicsGrade, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                </StackPanel>
                <StackPanel Margin="6,0,0,0">
                    <TextBlock Text="Hóa" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding ChemistryGrade, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                </StackPanel>
            </StackPanel>


            <!-- Hiển thị GPA + Rank realtime -->
            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="GPA:" FontWeight="Bold"/>
                <TextBlock Text="{Binding GPA}" Margin="4,0"/>
                <TextBlock Text=" - Rank:" FontWeight="Bold" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding Rank}" Margin="4,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Button Content="Upload ảnh"
                        Command="{Binding UploadImageCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                <Button Content="Lưu"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="8,0"/>
                <Button Content="Reset"
                        Command="{Binding ResetCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="8,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Ảnh sinh viên -->
        <Border Grid.Column="1"
                Background="#FFF"
                CornerRadius="6"
                Padding="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
            <Image Source="{Binding ImageBase64, Converter={StaticResource Base64ToImageConverter}}"
                   Width="200"
                   Height="200"/>
        </Border>
    </Grid>
</UserControl>
