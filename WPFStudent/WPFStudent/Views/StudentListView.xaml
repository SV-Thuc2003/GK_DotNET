<UserControl x:Class="WPFStudent.Views.StudentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WPFStudent.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:WPFStudent.Converters">

    <UserControl.Resources>
        <!-- Converter Base64 -> Image -->
        <conv:Base64ToImageConverter x:Key="Base64ToImageConverter"/>
    </UserControl.Resources>

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Search + Filters -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Paging -->
        </Grid.RowDefinitions>

        <!-- ===== SEARCH + FILTER ===== -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center" >

            <!-- Search box -->
            <TextBox Width="250"
                     materialDesign:HintAssist.Hint="Tìm theo tên hoặc MSSV"
                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

            <!-- Gender filter -->
            <ComboBox Width="120" Margin="12,0,0,0"
                      materialDesign:HintAssist.Hint="Giới tính"
                      ItemsSource="{Binding GenderFilterList}"
                      SelectedItem="{Binding GenderFilter}"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

            <!-- Sort age button -->
            <Button Content="Sort Tuổi"
                    Command="{Binding SortByAgeCommand}"
                    Margin="12,0,0,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>

        <!-- ===== DATAGRID ===== -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding StudentsView}"
                  SelectedItem="{Binding SelectedStudent}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True">

            <DataGrid.Columns>

                <!-- Avatar -->
                <DataGridTemplateColumn Header="Ảnh" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImageBase64, Converter={StaticResource Base64ToImageConverter}}"
                                   Width="50" Height="50"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Mã SV" Binding="{Binding StudentId}" Width="*"/>
                <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Tuổi" Binding="{Binding Age}" Width="60"/>
                <DataGridTextColumn Header="Giới tính" Binding="{Binding Gender}" Width="90"/>
                <DataGridTextColumn Header="GPA" Binding="{Binding GPA}" Width="60"/>
                <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="90"/>

                <!-- Delete button -->
                <DataGridTemplateColumn Header="Xóa" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🗑"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Foreground="Red"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== PAGING ===== -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center">

            <Button Content="« Prev"
                    Command="{Binding PrevPageCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>

            <TextBlock Text="{Binding PageIndex}"
                       VerticalAlignment="Center"
                       Margin="12,0"/>

            <TextBlock Text="/"
                       VerticalAlignment="Center"/>

            <TextBlock Text="{Binding TotalPages}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

            <Button Content="Next »"
                    Command="{Binding NextPageCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>

    </Grid>
</UserControl>
