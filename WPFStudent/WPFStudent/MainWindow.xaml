<Window x:Class="WPFStudent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WPFStudent.Views"
        xmlns:vm="clr-namespace:WPFStudent.ViewModels"
        Title="Quản lý sinh viên"
        Height="500" Width="900">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Map ViewModel -> View -->
        <DataTemplate DataType="{x:Type vm:StudentListViewModel}">
            <views:StudentListView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StudentFormViewModel}">
            <views:StudentFormView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- MENU -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="8">
            <Button Content="Danh sách"
                    Command="{Binding ShowListCommand}"
                    Margin="4"/>

            <Button Content="Thêm / Sửa"
                    Command="{Binding ShowFormCommand}"
                    Margin="4"/>
        </StackPanel>

        <!-- NỘI DUNG -->
        <Border Margin="8" BorderBrush="#DDD" BorderThickness="1">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>

    </DockPanel>
</Window>
